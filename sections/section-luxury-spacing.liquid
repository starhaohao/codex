{% comment %}
  Luxury spacing overrides — applies to collection and product pages.
  Add to any collection or product template to get generous negative space,
  ultra-light typography, and relaxed grid matching a luxury retail standard.
{% endcomment %}
<style>
  .template-collection,
  .template-product {
    --triiiple-collection-grid-padding-top: {{ section.settings.collection_grid_padding_top }}px;
    --triiiple-collection-grid-padding-bottom: {{ section.settings.collection_grid_padding_bottom }}px;
    --triiiple-product-description-padding-top: {{ section.settings.product_description_padding_top }}px;
    --triiiple-product-description-padding-bottom: {{ section.settings.product_description_padding_bottom }}px;
    --triiiple-product-description-heading-top: {{ section.settings.product_description_heading_top }}px;
    --triiiple-product-description-heading-bottom: {{ section.settings.product_description_heading_bottom }}px;
  }

  /* ─────────────────────────────────────────────────────────────────
     SHARED — Header
     ───────────────────────────────────────────────────────────────── */
  .header__inner,
  .site-header__inner,
  [class*="header__main"] {
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    min-height: 64px;
  }

  /* ─────────────────────────────────────────────────────────────────
     COLLECTION — Grid layout
     ───────────────────────────────────────────────────────────────── */

  /* Force 4 columns on desktop with 48px gap */
  @media only screen and (min-width: 990px) {
    .template-collection .collection__products .grid,
    .template-collection .grid-outer .grid,
    .template-collection .product-grid {
      --COLUMNS: 4 !important;
      --gap: 48px !important;
      --gutter: 48px !important;
      grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
      column-gap: 48px !important;
      row-gap: 0 !important;
    }

    /* Side padding on grid container */
    .template-collection .collection__products .grid-outer {
      padding-left: 12px !important;
      padding-right: 12px !important;
      padding-top: var(--triiiple-collection-grid-padding-top) !important;
      padding-bottom: var(--triiiple-collection-grid-padding-bottom) !important;
    }
  }

  /* 2 columns on tablet */
  @media only screen and (min-width: 750px) and (max-width: 989px) {
    .template-collection .collection__products .grid,
    .template-collection .grid-outer .grid {
      --COLUMNS: 2 !important;
      grid-template-columns: repeat(2, 1fr) !important;
      column-gap: 24px !important;
      row-gap: 0 !important;
    }
  }

  /* Product card — remove all internal padding/margin from image */
  .template-collection .product-item {
    margin: 0;
  }

  .template-collection .collection__products .grid-outer {
    padding-top: var(--triiiple-collection-grid-padding-top) !important;
    padding-bottom: var(--triiiple-collection-grid-padding-bottom) !important;
  }

  /* Product card info area — tight, precise spacing */
  .template-collection .product-item__info {
    padding: 10px 0 20px !important;
  }
  @media only screen and (max-width: 749px) {
    .template-collection .product-item__info {
      padding: 8px 0 16px !important;
    }
  }

  /* Product title — suisse-light equivalent: weight 300, wide tracking, uppercase */
  .template-collection .product-item__title,
  .template-collection .product-item__title * {
    font-size: 11px !important;
    font-weight: 300 !important;
    letter-spacing: 2.08px !important;
    text-transform: uppercase !important;
    line-height: 1 !important;
    margin: 0 0 6px !important;
  }

  /* Product price */
  .template-collection .product-item__price,
  .template-collection .product-item__price__holder,
  .template-collection .product-item__price * {
    font-size: 11px !important;
    font-weight: 300 !important;
    letter-spacing: 0.48px !important;
    line-height: 1 !important;
  }

  /* Product vendor / cutline */
  .template-collection .product-item__cutline {
    font-size: 10px !important;
    font-weight: 300 !important;
    letter-spacing: 0.48px !important;
    margin-bottom: 3px !important;
  }

  /* ─────────────────────────────────────────────────────────────────
     COLLECTION — Filter / category bar
     ───────────────────────────────────────────────────────────────── */
  .template-collection .collection__nav {
    min-height: 32px !important;
    align-items: center;
  }

  /* Filter tab links */
  .template-collection .collection__nav a,
  .template-collection .collection__nav button,
  .template-collection .collection__nav .collection__linklist a,
  .template-collection .linklist a,
  .template-collection .collection-linklist a {
    font-size: 13px !important;
    font-weight: 400 !important;
    letter-spacing: 0 !important;
    text-transform: none !important;
    line-height: 1.2 !important;
  }

  /* Linklist column gap */
  .template-collection .collection__linklist,
  .template-collection .linklist {
    column-gap: 48px !important;
  }

  /* ─────────────────────────────────────────────────────────────────
     COLLECTION — Page heading (H1 banner)
     ───────────────────────────────────────────────────────────────── */
  .template-collection .page-heading,
  .template-collection .collection__heading,
  .template-collection h1.visually-hidden,
  .template-collection .collection-image-with-title .hero__title {
    font-size: 32px !important;
    font-weight: 400 !important;
    letter-spacing: 0 !important;
    text-transform: none !important;
    line-height: 1.15 !important;
    margin: 0 0 18px !important;
    padding: 0 !important;
  }

  .template-collection .collection-image-with-title .hero__description,
  .template-collection .collection-image-with-title .hero__description p {
    max-width: 640px;
    margin: 0 !important;
    font-size: 15px !important;
    font-weight: 400 !important;
    letter-spacing: 0 !important;
    line-height: 1.55 !important;
  }

  .template-collection .collection-image-with-title .hero__content,
  .template-collection .collection__title--no-image {
    padding: 24px !important;
  }

  /* ─────────────────────────────────────────────────────────────────
     PRODUCT DETAIL PAGE — Typography & spacing
     ───────────────────────────────────────────────────────────────── */

  /* Product name H1 */
  .template-product .product__title,
  .template-product .product__title h1,
  .template-product .product-single__title,
  .template-product .product__title__wrapper h1 {
    font-size: 28px !important;
    font-weight: 400 !important;
    letter-spacing: 0 !important;
    text-transform: none !important;
    line-height: 1.2 !important;
    margin-top: 0 !important;
  }

  /* Price */
  .template-product .product__price,
  .template-product .product__price__wrap,
  .template-product .product__price * {
    font-size: 14px !important;
    font-weight: 400 !important;
    letter-spacing: 0 !important;
    line-height: 1.4 !important;
  }
  .template-product .product__price__wrap {
    margin-top: 12px !important;
    min-height: auto;
    display: flex;
    align-items: center;
  }

  /* Colour / option labels */
  .template-product .selector-wrapper__label,
  .template-product .selector-label,
  .template-product .variant-label,
  .template-product label.label,
  .template-product .radio__legend,
  .template-product .radio__legend__label {
    font-size: 12px !important;
    font-weight: 600 !important;
    letter-spacing: 0 !important;
    text-transform: none !important;
    line-height: 1.3 !important;
  }

  /* Colour swatch gap */
  .template-product .radio__fieldset--swatches,
  .template-product .swatch__list,
  .template-product [class*="swatches"] {
    gap: 12px !important;
  }

  /* Description body copy */
  .template-product .product__description,
  .template-product .product__description p,
  .template-product .rte p,
  .template-product .product-description p {
    font-size: 14px !important;
    font-weight: 400 !important;
    letter-spacing: 0 !important;
    line-height: 1.55 !important;
  }

  .template-product .product__description {
    max-width: 430px;
    padding-top: var(--triiiple-product-description-padding-top) !important;
    padding-bottom: var(--triiiple-product-description-padding-bottom) !important;
  }

  .template-product .product__description__content h2,
  .template-product .product__description__content h3,
  .template-product .product__description__content h4 {
    font-size: 12px !important;
    font-weight: 600 !important;
    letter-spacing: 0 !important;
    text-transform: none !important;
    line-height: 1.4 !important;
    margin-top: var(--triiiple-product-description-heading-top) !important;
    margin-bottom: var(--triiiple-product-description-heading-bottom) !important;
  }

  .template-product .product__description__content ul,
  .template-product .product__description__content ol,
  .template-product .product__description__content li,
  .template-product .product__description__content a {
    font-size: 14px !important;
    font-weight: 400 !important;
    letter-spacing: 0 !important;
    line-height: 1.55 !important;
  }

  .template-product .product__description__content a {
    color: inherit !important;
    text-decoration: underline !important;
    text-underline-offset: 2px;
  }

  /* SKU / reference */
  .template-product .product__sku,
  .template-product .product__ref,
  .template-product [class*="sku"] {
    font-size: 12px !important;
    font-weight: 400 !important;
    letter-spacing: 0 !important;
    line-height: 1.4 !important;
  }

  .template-product .product__content .form__wrapper,
  .template-product .product__content product-form {
    max-width: 430px;
  }

  .template-product .radio__fieldset .radio__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 !important;
  }

  .template-product .radio__fieldset .radio__button {
    padding: 0 !important;
  }

  .template-product .radio__fieldset .radio__button label {
    min-width: 42px;
    min-height: 36px;
    padding: 0 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0 !important;
    font-size: 12px !important;
    font-weight: 400 !important;
    letter-spacing: 0 !important;
    line-height: 1 !important;
    text-transform: none !important;
  }

  .template-product .selector-wrapper--color .radio__button label {
    min-width: 70px;
  }

  /* Add to Basket / Add to Cart button */
  .template-product .btn--add-to-cart,
  .template-product [data-add-to-cart],
  .template-product .product-form__submit,
  .template-product product-form .btn,
  .template-product .product-form .btn--primary,
  .template-product .product-form .btn--secondary {
    font-size: 12px !important;
    font-weight: 600 !important;
    letter-spacing: 0 !important;
    text-transform: none !important;
    height: 48px !important;
    min-height: 48px !important;
    line-height: 1 !important;
    padding: 0 16px !important;
    background: var(--text) !important;
    color: var(--bg) !important;
    border: 1px solid var(--text) !important;
    border-radius: 0 !important;
    width: 100% !important;
    max-width: 430px;
  }
  .template-product .btn--add-to-cart:hover,
  .template-product product-form .btn:hover,
  .template-product .product-form .btn--primary:hover,
  .template-product .product-form .btn--secondary:hover {
    background: var(--text) !important;
    color: var(--bg) !important;
  }

  /* Accordion / tab section titles */
  .template-product .accordion__title,
  .template-product .tabs__tab,
  .template-product .tab__title,
  .template-product .collapsible__title,
  .template-product [class*="accordion__heading"],
  .template-product .tab-richtext__tab {
    font-size: 12px !important;
    font-weight: 600 !important;
    letter-spacing: 0 !important;
    line-height: 1.3 !important;
    padding: 12px 30px !important;
    color: #555555 !important;
    margin-top: 10px !important;
    text-transform: none !important;
  }

  /* ─────────────────────────────────────────────────────────────────
     PRODUCT DETAIL — Layout: generous top padding
     ───────────────────────────────────────────────────────────────── */
  @media only screen and (min-width: 750px) {
    .template-product .product,
    .template-product .featured-product__body,
    .template-product .product-single {
      padding-top: 20px !important;
    }
  }

  /* ─────────────────────────────────────────────────────────────────
     SHARED — Remove excessive border-radius for clean luxury feel
     ───────────────────────────────────────────────────────────────── */
  .template-collection .btn,
  .template-collection .badge-box,
  .template-product .btn,
  .template-product .badge-box {
    border-radius: 0 !important;
  }

  @media only screen and (max-width: 749px) {
    .template-collection .collection-image-with-title .hero__content,
    .template-collection .collection__title--no-image {
      padding: 26px 14px 50px !important;
    }

    .template-collection .collection-image-with-title .hero__title {
      font-size: 24px !important;
      line-height: 1.2 !important;
      margin-bottom: 14px !important;
    }

    .template-collection .collection-image-with-title .hero__description,
    .template-collection .collection-image-with-title .hero__description p {
      font-size: 14px !important;
      line-height: 1.5 !important;
    }

    .template-collection .collection__nav {
      min-height: 64px !important;
    }

    .template-collection .collection__nav a,
    .template-collection .collection__nav button,
    .template-collection .collection__nav .collection__linklist a,
    .template-collection .linklist a,
    .template-collection .collection-linklist a {
      font-size: 12px !important;
    }

    .template-collection .collection__linklist,
    .template-collection .linklist {
      column-gap: 28px !important;
    }

    .template-product .product__title,
    .template-product .product__title h1,
    .template-product .product-single__title,
    .template-product .product__title__wrapper h1 {
      font-size: 24px !important;
    }
  }
  /* ─────────────────────────────────────────────────────────────────
     SHARED — Announcement bar: thinner strip
     ───────────────────────────────────────────────────────────────── */
  .page-announcement .announcement__slide,
  .page-announcement .announcement__bar {
    --PT: 5px !important;
    --PB: 5px !important;
    min-height: 28px !important;
  }
  .page-announcement {
    --ANNOUNCEMENT-HEIGHT-DESKTOP: 28px !important;
    --ANNOUNCEMENT-HEIGHT-MOBILE: 28px !important;
  }
</style>

{% schema %}
{
  "name": "Luxury Spacing",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Collection grid padding"
    },
    {
      "type": "range",
      "id": "collection_grid_padding_top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "collection_grid_padding_bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Bottom",
      "default": 64
    },
    {
      "type": "header",
      "content": "Product description padding"
    },
    {
      "type": "range",
      "id": "product_description_padding_top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "product_description_padding_bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Bottom",
      "default": 16
    },
    {
      "type": "header",
      "content": "Product description headings"
    },
    {
      "type": "range",
      "id": "product_description_heading_top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Top spacing",
      "default": 28
    },
    {
      "type": "range",
      "id": "product_description_heading_bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 14
    }
  ],
  "presets": [
    { "name": "Luxury Spacing" }
  ],
  "enabled_on": {
    "templates": ["collection", "product", "index", "page"]
  },
  "limit": 1
}
{% endschema %}
